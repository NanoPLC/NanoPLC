{
  "schema_version": 1,
  "name": "blink_fbd",
  "device": {
    "board": "esp32-s3",
    "idf_target": "esp32s3"
  },
  "scan": {
    "period_ms": 10
  },
  "modules": [
    {
      "id": "gpio1",
      "name": "Onboard GPIO (digital)",
      "type": "gpio_digital_io",
      "config": "src/io-map.json"
    }
  ],
  "drivers": [
    {
      "id": "hal_gpio",
      "name": "GPIO process image (nanoplc_hal)",
      "type": "nanoplc_hal",
      "binds": "gpio1"
    }
  ],
  "programs": [
    {
      "id": "main",
      "name": "Main",
      "source": "src/main.fbd.json",
      "language": "fbd"
    }
  ],
  "tasks": [
    {
      "id": "main_task",
      "name": "MainTask",
      "kind": "cyclic",
      "priority": 1,
      "interval_ms": 10,
      "watchdog": {
        "enabled": true,
        "time_ms": 50
      },
      "program": "main"
    }
  ],
  "firmware_root": "../../firmware"
}
