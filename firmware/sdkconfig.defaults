# NanoPLC defaults for ESP32-S3 (additional symbols materialize after `idf.py set-target esp32s3`).

CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# 1 ms RTOS tick so PLC task intervals are not rounded down to 10 ms steps.
CONFIG_FREERTOS_HZ=1000

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Online debug UART telemetry (docs/DEBUG_PROTOCOL.md). Disable for production.
CONFIG_NANOPLC_DEBUG_TELEMETRY=y
