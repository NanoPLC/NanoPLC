{
  "name": "nanoplc-iec",
  "displayName": "NanoPLC IEC 61131-3",
  "description": "Foundation for ESP32 and MCU programming in IEC ST, LAD, and FBD",
  "version": "0.1.0",
  "publisher": "nanoplc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanoplc/nanoplc.git",
    "directory": "nanoplc-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "PLC",
    "IEC 61131-3",
    "Structured Text",
    "Ladder",
    "FBD",
    "ESP32"
  ],
  "activationEvents": [
    "workspaceContains:**/nanoplc.project.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "iec-st",
        "aliases": [
          "IEC ST",
          "Structured Text"
        ],
        "extensions": [
          ".st",
          ".iecst"
        ],
        "configuration": "./language-configuration/iec-st-language-configuration.json"
      },
      {
        "id": "iec-lad",
        "aliases": [
          "IEC LAD",
          "Ladder"
        ],
        "extensions": [
          ".lad",
          ".ld"
        ],
        "configuration": "./language-configuration/iec-lad-language-configuration.json"
      },
      {
        "id": "iec-fbd",
        "aliases": [
          "IEC FBD",
          "Function Block Diagram"
        ],
        "extensions": [
          ".fbd"
        ],
        "configuration": "./language-configuration/iec-fbd-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "iec-st",
        "scopeName": "source.iec.st",
        "path": "./syntaxes/iec-st.tmLanguage.json"
      },
      {
        "language": "iec-lad",
        "scopeName": "source.iec.lad",
        "path": "./syntaxes/iec-lad.tmLanguage.json"
      },
      {
        "language": "iec-fbd",
        "scopeName": "source.iec.fbd",
        "path": "./syntaxes/iec-fbd.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "nanoplc.fbdEditor",
        "displayName": "FBD Diagram",
        "selector": [
          {
            "filenamePattern": "*.fbd.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "nanoplc.showTargetInfo",
        "title": "NanoPLC: Target platform info"
      },
      {
        "command": "nanoplc.setupToolchain",
        "title": "NanoPLC: Setup ESP-IDF toolchain (clone + install)"
      },
      {
        "command": "nanoplc.checkToolchain",
        "title": "NanoPLC: Check idf.py in PATH"
      },
      {
        "command": "nanoplc.addEspIdfToPowerShellProfile",
        "title": "NanoPLC: Add ESP-IDF export to PowerShell profile(s)"
      },
      {
        "command": "nanoplc.firmwareBuild",
        "title": "NanoPLC: Build firmware (idf.py build)",
        "icon": "$(tools)"
      },
      {
        "command": "nanoplc.firmwareFlash",
        "title": "NanoPLC: Flash firmware (idf.py flash)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "nanoplc.firmwareMonitor",
        "title": "NanoPLC: Serial monitor (idf.py monitor)",
        "icon": "$(output)"
      },
      {
        "command": "nanoplc.firmwareFlashMonitor",
        "title": "NanoPLC: Flash and monitor (idf.py flash monitor)"
      },
      {
        "command": "nanoplc.firmwareSetTarget",
        "title": "NanoPLC: Set ESP-IDF target (idf.py set-target)"
      },
      {
        "command": "nanoplc.firmwareDiagnose",
        "title": "NanoPLC: Diagnose firmware build environment"
      },
      {
        "command": "nanoplc.initFirmwareTree",
        "title": "NanoPLC: Init firmware tree (ESP-IDF skeleton)"
      },
      {
        "command": "nanoplc.createProject",
        "title": "NanoPLC: Add device",
        "icon": "$(add)"
      },
      {
        "command": "nanoplc.addDevice",
        "title": "NanoPLC: Add device (alias)"
      },
      {
        "command": "nanoplc.addModule",
        "title": "NanoPLC: Add I/O module",
        "icon": "$(add)"
      },
      {
        "command": "nanoplc.addDriver",
        "title": "NanoPLC: Add driver",
        "icon": "$(add)"
      },
      {
        "command": "nanoplc.addProgram",
        "title": "NanoPLC: Add program (POU)",
        "icon": "$(add)"
      },
      {
        "command": "nanoplc.addTask",
        "title": "NanoPLC: Add task",
        "icon": "$(add)"
      },
      {
        "command": "nanoplc.configureTask",
        "title": "NanoPLC: Configure task"
      },
      {
        "command": "nanoplc.deleteTask",
        "title": "NanoPLC: Delete task"
      },
      {
        "command": "nanoplc.addProgramToTask",
        "title": "NanoPLC: Assign program to task",
        "icon": "$(add)"
      },
      {
        "command": "nanoplc.removeProgramFromTask",
        "title": "NanoPLC: Remove program from task"
      },
      {
        "command": "nanoplc.compileProgram",
        "title": "NanoPLC: Compile PLC program",
        "icon": "$(play)"
      },
      {
        "command": "nanoplc.refreshProjectTree",
        "title": "NanoPLC: Refresh project tree",
        "icon": "$(refresh)"
      },
      {
        "command": "nanoplc.startSimulation",
        "title": "NanoPLC: Run simulation",
        "icon": "$(debug-start)"
      },
      {
        "command": "nanoplc.stopSimulation",
        "title": "NanoPLC: Stop simulation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nanoplc.codegenFirmware",
        "title": "NanoPLC: Generate firmware C from IR"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nanoplc",
          "title": "NanoPLC",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "nanoplc": [
        {
          "id": "nanoplcProject",
          "name": "Project"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "nanoplc.compileProgram",
          "when": "activeCustomEditorId == nanoplc.fbdEditor",
          "group": "navigation@1"
        },
        {
          "command": "nanoplc.firmwareBuild",
          "when": "activeCustomEditorId == nanoplc.fbdEditor",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "nanoplc.createProject",
          "when": "view == nanoplcProject",
          "group": "navigation@1"
        },
        {
          "command": "nanoplc.refreshProjectTree",
          "when": "view == nanoplcProject",
          "group": "navigation"
        },
        {
          "command": "nanoplc.compileProgram",
          "when": "view == nanoplcProject",
          "group": "navigation"
        },
        {
          "command": "nanoplc.firmwareBuild",
          "when": "view == nanoplcProject",
          "group": "navigation"
        },
        {
          "command": "nanoplc.startSimulation",
          "when": "view == nanoplcProject",
          "group": "navigation"
        },
        {
          "command": "nanoplc.stopSimulation",
          "when": "view == nanoplcProject",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "nanoplc.addModule",
          "when": "view == nanoplcProject && viewItem == modules_group",
          "group": "inline@1"
        },
        {
          "command": "nanoplc.addDriver",
          "when": "view == nanoplcProject && viewItem == drivers_group",
          "group": "inline@1"
        },
        {
          "command": "nanoplc.addProgram",
          "when": "view == nanoplcProject && viewItem == programs_group",
          "group": "inline@1"
        },
        {
          "command": "nanoplc.addTask",
          "when": "view == nanoplcProject && viewItem == tasks_group",
          "group": "inline@1"
        },
        {
          "command": "nanoplc.addProgramToTask",
          "when": "view == nanoplcProject && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "nanoplc.configureTask",
          "when": "view == nanoplcProject && viewItem == task",
          "group": "1_modification@1"
        },
        {
          "command": "nanoplc.deleteTask",
          "when": "view == nanoplcProject && viewItem == task",
          "group": "1_modification@2"
        },
        {
          "command": "nanoplc.removeProgramFromTask",
          "when": "view == nanoplcProject && viewItem == task_pou",
          "group": "1_modification@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "NanoPLC",
        "properties": {
          "nanoplc.targetChip": {
            "type": "string",
            "default": "esp32-s3",
            "description": "Target MCU preset (primary focus: ESP32-S3).",
            "enum": [
              "esp32",
              "esp32-c3",
              "esp32-s3",
              "rp2040",
              "stm32",
              "generic"
            ]
          },
          "nanoplc.firmwareRoot": {
            "type": "string",
            "default": "firmware",
            "description": "Relative path from the workspace root to the ESP-IDF application (see docs/VIRTUAL_PLC_PLAN.md)."
          },
          "nanoplc.simulatorRefreshMs": {
            "type": "number",
            "default": 50,
            "minimum": 16,
            "description": "Minimum interval (ms) for refreshing the simulator I/O panel during a run."
          },
          "nanoplc.codegenOnCompile": {
            "type": "boolean",
            "default": true,
            "description": "After Compile PLC program, emit plc_program.c into the firmware nanoplc_generated component."
          },
          "nanoplc.buildFirmwareOnCompile": {
            "type": "boolean",
            "default": true,
            "description": "After Compile PLC program (and codegen), run idf.py build for the project device (uses device.idf_target and project firmware_root)."
          }
        }
      },
      {
        "title": "NanoPLC ESP-IDF",
        "properties": {
          "nanoplc-idf.distRoot": {
            "type": "string",
            "default": "",
            "description": "Toolchain install root (empty = ~/.nanoplc or %USERPROFILE%\\.nanoplc). See docs/BOOTSTRAP_TOOLCHAIN.md."
          },
          "nanoplc-idf.idfRelease": {
            "type": "string",
            "default": "v5.3.3",
            "description": "Git tag for espressif/esp-idf shallow clone (--branch)."
          },
          "nanoplc-idf.idfSetupScript": {
            "type": "string",
            "default": "",
            "description": "Path to export.ps1 (Windows) or export.sh (Unix) after installation; paste from bootstrap output."
          },
          "nanoplc-idf.buildTarget": {
            "type": "string",
            "default": "esp32s3",
            "description": "Target passed to install.bat / install.sh (same as idf.py set-target)."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/sync-ir-schema.js && node scripts/sync-firmware-template.js && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package:vsix": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@nanoplc/ir-schema": "file:../packages/ir-schema"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "keytar@7.9.0": true
  }
}
